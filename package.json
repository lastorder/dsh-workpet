{
  "name": "dsh-workpet-root",
  "version": "0.2.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"packages/*/*/tests/*.test.ts\" \"packages/*/*/tests/*.test.mjs\" \"scripts/*.test.mjs\"",
    "verify": "pnpm run build && pnpm run typecheck && pnpm run test",
    "clean": "node scripts/clean.mjs",
    "release:version": "node scripts/release.mjs version",
    "release:check": "node scripts/release.mjs check",
    "release:publish": "node scripts/release.mjs publish",
    "prepublishOnly": "node -e \"console.error('dsh-workpet-root is the private workspace root and is never published. Publish the packages with: pnpm run release:publish'); process.exit(1)\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.12",
    "esbuild": "^0.28.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "typescript": "~7.0.2"
  }
}
